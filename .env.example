# Copy to .env.local for local development. Set the same names in Vercel (Production).

# Sign-in (required). At least 32 random characters: `openssl rand -base64 48`
AUTH_SECRET=
# Who can sign in: anyone at these domains (default theinfluenceagency.com)...
ALLOWED_DOMAINS=theinfluenceagency.com
# ...plus these individual addresses (Surplus reviewers), comma-separated
REVIEWER_EMAILS=
# Who gets the weekly "descriptions are ready" email (must also be allowed above)
NOTIFY_EMAILS=
# Public URL used in emailed links (Vercel's production URL is used when unset)
APP_URL=

# Email via Mailgun's HTTP API. Unset locally: links are printed to the server log instead.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.theinfluenceagency.com
MAIL_FROM="Surplus product descriptions <copy@mg.theinfluenceagency.com>"

# Weekly run
CRON_SECRET=
WINDSOR_API_KEY=
MERCHANT_ACCOUNT_ID=743756928
ANTHROPIC_API_KEY=
MAX_PRODUCTS_PER_RUN=12
# 1 = let Claude search the web for each exact product (slower; fewer products fit in a run)
PIPELINE_RESEARCH=0

# Storage: set automatically when a Vercel Blob store is connected to the project.
# Unset locally: data is written to ./.data instead.
BLOB_READ_WRITE_TOKEN=
